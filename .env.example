# Copy this file to .env (local) and add the same values in Netlify → Site configuration → Environment variables.
# Never commit .env.

# Neon → your project → Connection details → "Connection string" (pooled is fine).
# Use the dev branch locally and for deploy previews; the main branch only for production.
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon Auth (managed Better Auth). Every Neon branch has its own Auth URL and its own accounts,
# so use the URL of the same branch DATABASE_URL points at.
# Neon Console → your branch → Auth → Configuration (the "Auth URL").
NEON_AUTH_BASE_URL=https://ep-example-123456.neonauth.us-east-2.aws.neon.tech/neondb/auth
# Signs the short-lived session cache cookie. At least 32 characters:  openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=replace-with-at-least-32-random-characters
# The service account the server uses for Neon Auth's admin API (creating accounts, setting
# passwords, deactivating). Create it once per branch and give it the "admin" role (see README).
# It is the only account with that role and can't sign in to the app itself.
NEON_AUTH_SERVICE_EMAIL=service@hersnetwork.org
NEON_AUTH_SERVICE_PASSWORD=replace-with-a-long-random-password

# The address people use to reach the app, no trailing slash, e.g. http://localhost:3000 locally,
# https://hersnetwork-events.netlify.app in production. Used for staff sign-up links and as the
# Origin of the server's calls to Neon Auth, so it must be listed under Neon Auth → Domains.
APP_URL=http://localhost:3000

# Optional: set to "pg" to use an ordinary Postgres server instead of Neon (a localhost URL does this automatically).
# Neon Auth still needs a Neon branch, so this is only useful for working on the data layer offline.
# DATABASE_DRIVER=pg

# Optional: Sentry error reporting (leave empty to switch it off). Same DSN in both.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
